        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/evidence/{evidenceId}:download": {
      "parameters": [{ "$ref": "#/components/parameters/EvidenceId" }],
      "post": {
        "operationId": "requestEvidenceDownload",
        "tags": ["Evidence"],
        "x-permission": "evidence:read",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["evidence:read"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Reason" },
        "responses": { "200": { "$ref": "#/components/responses/DownloadGrant" }, "403": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/evidence/{evidenceId}/payload": {
      "parameters": [{ "$ref": "#/components/parameters/EvidenceId" }],
      "get": {
        "operationId": "streamSensitiveEvidencePayload",
        "tags": ["Evidence"],
        "x-permission": "evidence:read:sensitive",
        "security": [{ "oidc": ["evidence:read:sensitive"] }],
        "responses": {
          "200": {
            "description": "Authenticated HIGH sensitivity payload stream; never a redirect or presigned URL.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": { "application/octet-stream": { "schema": { "type": "string", "contentEncoding": "binary" } } }
          },
          "403": { "$ref": "#/components/responses/Problem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/rule-sets": {
      "post": {
        "operationId": "createRuleSet",
        "tags": ["Quality"],
        "x-permission": "rule:write",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["rule:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/RuleSet" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "422": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/rule-sets/{id}:publish": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "operationId": "publishRuleSet",
        "tags": ["Quality"],
        "x-permission": "rule:publish",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["rule:publish"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/Reason" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/quality-evaluations": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "post": {
        "operationId": "requestQualityEvaluation",
        "tags": ["Quality"],
        "x-permission": "quality:evaluate",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["quality:evaluate"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/QualityEvaluation" },
        "responses": { "202": { "$ref": "#/components/responses/Accepted" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/quality-results": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "get": {
        "operationId": "getQualityResults",
        "tags": ["Quality"],
        "x-permission": "quality:read",
        "security": [{ "oidc": ["quality:read"] }],
        "responses": { "200": { "$ref": "#/components/responses/ResourceList" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quality-results/{id}:override": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "operationId": "createGovernanceOverride",
        "tags": ["Quality"],
        "x-permission": "quality:override",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["quality:override"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/GovernanceDecision" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}:approve": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "post": {
        "operationId": "approveRelease",
        "tags": ["Release"],
        "x-permission": "release:approve",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["release:approve"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/Reason" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/agents:register": {
      "post": {
        "operationId": "registerAgent",
        "tags": ["Agent"],
        "x-permission": "agent:register",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentRegistration" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "426": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/agents/{id}:heartbeat": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "operationId": "heartbeatAgent",
        "tags": ["Agent"],
        "x-permission": "agent:heartbeat",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentHeartbeat" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/agents/{id}/commands:poll": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "operationId": "pollAgentCommands",
        "tags": ["Agent"],
        "x-permission": "agent:poll",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentPoll" },
        "responses": { "200": { "$ref": "#/components/responses/AgentCommand" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/commands/{commandId}:ack": {
      "parameters": [{ "$ref": "#/components/parameters/CommandId" }],
      "post": {
        "operationId": "acknowledgeAgentCommand",
        "tags": ["Agent"],
        "x-permission": "agent:execute",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentAck" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/commands/{commandId}/events": {
      "parameters": [{ "$ref": "#/components/parameters/CommandId" }],
      "post": {
        "operationId": "appendAgentCommandEvent",
        "tags": ["Agent"],
        "x-permission": "agent:execute",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentEvent" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/evidence/uploads": {
      "post": {
        "operationId": "createEvidenceUpload",
        "tags": ["Agent"],
        "x-permission": "agent:evidence:write",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentCreateUpload" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/evidence/uploads/{id}:complete": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "operationId": "completeEvidenceUpload",
        "tags": ["Agent"],
        "x-permission": "agent:evidence:write",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentCompleteUpload" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "422": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent-api/v1/attempts/{attemptId}/result": {
      "parameters": [{ "$ref": "#/components/parameters/AttemptId" }],
      "put": {
        "operationId": "putAttemptResult",
        "tags": ["Agent"],
        "x-permission": "agent:execute",
        "x-idempotency-required": true,
        "security": [{ "agentMtls": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentResult" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/authorize",
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "release:create": "Create Release identities",
              "release:read": "Read Releases",
              "release:approve": "Approve Releases",
              "manifest:write": "Register and validate Manifests",
              "manifest:lock": "Lock authoritative Manifests",
              "issue:snapshot": "Create Issue snapshots",
              "traceability:read": "Read traceability",
              "traceability:verify": "Verify traceability snapshots",
              "test:execute": "Create and cancel Test Runs",
              "test:read": "Read Test Results",
              "evidence:read": "Read Evidence metadata and non-HIGH payloads",
              "evidence:read:sensitive": "Read HIGH Evidence payloads",
              "rule:write": "Author Rule Sets",
              "rule:publish": "Publish Rule Sets",
              "quality:evaluate": "Request deterministic evaluations",
              "quality:read": "Read Quality Results",
              "quality:override": "Create governance decisions"
            }
          }
        }
      },
      "agentMtls": { "type": "mutualTLS" }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "IfMatch": { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ReleaseId": { "name": "releaseId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "ManifestId": { "name": "manifestId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "EvidenceId": { "name": "evidenceId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "CommandId": { "name": "commandId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "AttemptId": { "name": "attemptId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } }
    },
    "schemas": {
      "OpaqueId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "GenericResource": { "type": "object", "additionalProperties": true },
      "GenericList": {
        "type": "object",
        "required": ["items"],
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/GenericResource" } }, "nextCursor": { "type": ["string", "null"] } },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "requestId"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "requestId": { "$ref": "#/components/schemas/OpaqueId" },
          "violations": { "type": "array", "items": { "$ref": "#/components/schemas/GenericResource" } }
        },
        "additionalProperties": false
      },
      "CreateReleaseRequest": {
        "type": "object",
        "required": ["project", "vehicle", "platform", "systemVersion", "buildId"],
        "properties": {
          "project": { "type": "string", "minLength": 1 },
          "vehicle": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "systemVersion": { "type": "string", "minLength": 1 },
          "buildId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "Reason": {
        "type": "object",
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "additionalProperties": false
      },
      "IdentifierInput": {
        "type": "object",
        "required": ["sourceId"],
        "properties": { "sourceId": { "$ref": "#/components/schemas/OpaqueId" } },
        "additionalProperties": false
      },
      "CreateTestRunRequest": {
        "type": "object",
        "required": ["releaseId", "testPlan", "deviceSelector"],
        "properties": {
          "releaseId": { "$ref": "#/components/schemas/OpaqueId" },
          "testPlan": {
            "type": "object",
            "required": ["planId", "version"],
            "properties": { "planId": { "$ref": "#/components/schemas/OpaqueId" }, "version": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          },
          "deviceSelector": {
            "type": "object",
            "required": ["vehicle", "requiredCapabilities"],
            "properties": { "vehicle": { "type": "string", "minLength": 1 }, "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "RuleSetRequest": {
        "type": "object",
        "required": ["ruleSetId", "version", "rules"],
        "properties": {
          "ruleSetId": { "$ref": "#/components/schemas/OpaqueId" },
          "version": { "type": "integer", "minimum": 1 },
          "rules": { "type": "array", "minItems": 1, "items": { "$ref": "../../../schemas/v0.2/quality-rule.schema.json" } }
        },
        "additionalProperties": false
      },
      "QualityEvaluationRequest": {
        "type": "object",
        "required": ["ruleSet", "testRunIds", "traceabilitySnapshotId"],
        "properties": {
          "ruleSet": {
            "type": "object",
            "required": ["ruleSetId", "version"],
            "properties": { "ruleSetId": { "$ref": "#/components/schemas/OpaqueId" }, "version": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          },
          "testRunIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/components/schemas/OpaqueId" } },
          "traceabilitySnapshotId": { "$ref": "#/components/schemas/OpaqueId" }
        },
        "additionalProperties": false
      },
      "GovernanceDecisionRequest": {
