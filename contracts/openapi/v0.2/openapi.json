        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/RegisterManifest" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "422": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/manifests/{manifestId}:validate": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }, { "$ref": "#/components/parameters/ManifestId" }],
      "post": {
        "operationId": "validateManifestRevision",
        "tags": ["Manifest"],
        "x-permission": "manifest:write",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["manifest:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Reason" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "422": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/manifests/{manifestId}:lock": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }, { "$ref": "#/components/parameters/ManifestId" }],
      "post": {
        "operationId": "lockManifestRevision",
        "tags": ["Manifest"],
        "x-permission": "manifest:lock",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["manifest:lock"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/Reason" },
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/issue-snapshots": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "post": {
        "operationId": "createIssueSnapshot",
        "tags": ["Traceability"],
        "x-permission": "issue:snapshot",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["issue:snapshot"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/IdentifierInput" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/traceability": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "get": {
        "operationId": "getReleaseTraceability",
        "tags": ["Traceability"],
        "x-permission": "traceability:read",
        "security": [{ "oidc": ["traceability:read"] }],
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/traceability:verify": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "post": {
        "operationId": "verifyReleaseTraceability",
        "tags": ["Traceability"],
        "x-permission": "traceability:verify",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["traceability:verify"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/IdentifierInput" },
        "responses": { "202": { "$ref": "#/components/responses/Accepted" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/test-runs": {
      "post": {
        "operationId": "createTestRun",
        "tags": ["Test"],
        "x-permission": "test:execute",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["test:execute"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/CreateTestRun" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/test-runs/{id}:cancel": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
