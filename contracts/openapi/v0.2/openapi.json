{
  "openapi": "3.1.0",
  "info": {
    "title": "Vehicle System Release Quality Gate API",
    "version": "0.2.0-draft.2",
    "description": "Machine-executable V0.2 draft. V0.1 Core Contract semantics remain authoritative."
  },
  "servers": [{ "url": "https://vsrqg.example" }],
  "tags": [
    { "name": "Release" },
    { "name": "Manifest" },
    { "name": "Traceability" },
    { "name": "Test" },
    { "name": "Evidence" },
    { "name": "Quality" },
    { "name": "Agent" }
  ],
  "paths": {
    "/api/v1/releases": {
      "post": {
        "operationId": "createRelease",
        "tags": ["Release"],
        "x-permission": "release:create",
        "x-idempotency-required": true,
        "security": [{ "oidc": ["release:create"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/CreateRelease" },
        "responses": { "201": { "$ref": "#/components/responses/ResourceCreated" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "get": {
        "operationId": "getRelease",
        "tags": ["Release"],
        "x-permission": "release:read",
        "security": [{ "oidc": ["release:read"] }],
        "responses": { "200": { "$ref": "#/components/responses/Resource" }, "default": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/releases/{releaseId}/manifests": {
      "parameters": [{ "$ref": "#/components/parameters/ReleaseId" }],
      "post": {
        "operationId": "registerManifestRevision",
