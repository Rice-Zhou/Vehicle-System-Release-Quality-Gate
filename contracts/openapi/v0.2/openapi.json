  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/authorize",
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "release:create": "Create Release identities",
              "release:read": "Read Releases",
              "release:approve": "Approve Releases",
              "manifest:write": "Register and validate Manifests",
              "manifest:lock": "Lock authoritative Manifests",
              "issue:sync": "Synchronize Issue sources",
              "issue:configure": "Configure Issue source mapping profiles",
              "issue:read": "Read Issue synchronization runs",
              "issue:snapshot": "Create Issue snapshots",
              "traceability:read": "Read traceability",
              "traceability:verify": "Verify traceability snapshots",
              "test:execute": "Create and cancel Test Runs",
              "test:read": "Read Test Results",
              "evidence:read": "Read Evidence metadata and non-HIGH payloads",
              "evidence:read:sensitive": "Read HIGH Evidence payloads",
              "rule:write": "Author Rule Sets",
              "rule:publish": "Publish Rule Sets",
              "quality:evaluate": "Request deterministic evaluations",
              "quality:read": "Read Quality Results",
              "quality:override": "Create governance decisions"
            }
          }
        }
      },
      "serviceOauth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "traceability:ingest": "Ingest Traceability facts as a service identity"
            }
          }
        }
      },
      "agentMtls": { "type": "mutualTLS" }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "IfMatch": { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ReleaseId": { "name": "releaseId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "ManifestId": { "name": "manifestId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "SourceId": { "name": "sourceId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "SyncRunId": { "name": "syncRunId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "EvidenceId": { "name": "evidenceId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "CommandId": { "name": "commandId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "AttemptId": { "name": "attemptId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } }
    },
    "schemas": {
      "OpaqueId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "GenericResource": { "type": "object", "additionalProperties": true },
      "GenericList": {
        "type": "object",
        "required": ["items"],
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/GenericResource" } }, "nextCursor": { "type": ["string", "null"] } },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "requestId"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "requestId": { "$ref": "#/components/schemas/OpaqueId" },
          "violations": { "type": "array", "items": { "$ref": "#/components/schemas/GenericResource" } }
        },
        "additionalProperties": false
      },
      "CreateReleaseRequest": {
        "type": "object",
        "required": ["project", "vehicle", "platform", "systemVersion", "buildId"],
        "properties": {
          "project": { "type": "string", "minLength": 1 },
          "vehicle": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "systemVersion": { "type": "string", "minLength": 1 },
          "buildId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "Reason": {
        "type": "object",
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "additionalProperties": false
      },
      "ManifestValidationReport": {
        "type": "object",
        "required": ["validationId", "manifestId", "status", "contentDigest", "schemaVersion", "violations", "validatedAt", "canonicalizationId", "validatorVersion", "canonicalByteLength"],
        "properties": {
          "validationId": { "$ref": "#/components/schemas/OpaqueId" },
          "manifestId": { "$ref": "#/components/schemas/OpaqueId" },
          "status": { "enum": ["VALID", "FAILED", "INCOMPLETE"] },
          "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "schemaVersion": { "type": "string", "minLength": 1 },
          "violations": { "type": "array", "items": { "$ref": "#/components/schemas/GenericResource" } },
          "validatedAt": { "type": "string", "format": "date-time" },
          "canonicalizationId": { "type": "string", "minLength": 1 },
          "validatorVersion": { "type": "string", "minLength": 1 },
          "canonicalByteLength": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "ManifestExport": {
        "type": "object",
        "required": ["releaseId", "manifestId", "manifestRevision", "state", "rawManifest", "contentDigest", "validation", "lockedAt"],
        "properties": {
          "releaseId": { "$ref": "#/components/schemas/OpaqueId" },
          "manifestId": { "$ref": "#/components/schemas/OpaqueId" },
          "manifestRevision": { "type": "integer", "minimum": 1 },
          "state": { "const": "LOCKED" },
          "rawManifest": { "$ref": "../../../schemas/v0.2/release-manifest.schema.json" },
          "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "validation": { "$ref": "#/components/schemas/ManifestValidationReport" },
          "lockedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "IdentifierInput": {
        "type": "object",
        "required": ["sourceId"],
        "properties": { "sourceId": { "$ref": "#/components/schemas/OpaqueId" } },
        "additionalProperties": false
      },
      "IssueMappingAliasToken": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "ActivateIssueMappingProfileRequest": {
        "type": "object",
        "required": [
          "schemaVersion",
          "normalizationVersion",
          "unknownStatusPolicy",
          "unknownSeverityPolicy",
          "statusAliases",
          "severityAliases"
        ],
        "properties": {
          "schemaVersion": { "type": "string", "const": "jira-mapping-profile/v1" },
          "normalizationVersion": { "type": "string", "const": "unicode-nfc-trim-root-lower/v1" },
          "unknownStatusPolicy": { "type": "string", "const": "MAP_TO_UNKNOWN_WITH_WARNING" },
          "unknownSeverityPolicy": { "type": "string", "const": "MAP_TO_UNKNOWN_WITH_WARNING" },
          "statusAliases": {
            "type": "object",
            "propertyNames": { "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"] },
            "additionalProperties": {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/components/schemas/IssueMappingAliasToken" }
            }
          },
          "severityAliases": {
            "type": "object",
            "propertyNames": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
            "additionalProperties": {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/components/schemas/IssueMappingAliasToken" }
            }
          }
        },
        "additionalProperties": false,
        "maxProperties": 6,
        "example": {
          "schemaVersion": "jira-mapping-profile/v1",
          "normalizationVersion": "unicode-nfc-trim-root-lower/v1",
          "unknownStatusPolicy": "MAP_TO_UNKNOWN_WITH_WARNING",
          "unknownSeverityPolicy": "MAP_TO_UNKNOWN_WITH_WARNING",
          "statusAliases": { "OPEN": ["synthetic-open"] },
          "severityAliases": { "HIGH": ["synthetic-high"] }
        }
      },
      "IssueMappingProfileActivation": {
        "type": "object",
        "required": ["profileId", "sourceId", "schemaVersion", "mappingVersion", "activatedAt"],
        "properties": {
          "profileId": { "$ref": "#/components/schemas/OpaqueId" },
          "sourceId": { "$ref": "#/components/schemas/OpaqueId" },
          "schemaVersion": { "type": "string", "const": "jira-mapping-profile/v1" },
          "mappingVersion": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "activatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "BuildProvenanceEnvelope": {
        "type": "object",
        "required": ["schemaVersion", "project", "releaseIssueSnapshotId", "provider", "repository", "sourceRevision", "pipeline", "buildId", "buildAttempt", "workflowReference", "proofReference", "proofDigest", "sourceIssueIds", "artifactSha256s"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 2 },
          "project": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "releaseIssueSnapshotId": { "$ref": "#/components/schemas/OpaqueId" },
          "provider": { "type": "string", "enum": ["GITHUB_ACTIONS"] },
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$", "maxLength": 512 },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "pipeline": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "buildId": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "buildAttempt": { "type": "integer", "minimum": 1 },
          "workflowReference": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "proofReference": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 1024, "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/actions/runs/[0-9]+/attempts/[1-9][0-9]*$" },
          "proofDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "sourceIssueIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }
          },
          "artifactSha256s": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "additionalProperties": false
      },
      "BuildProvenanceResult": {
        "type": "object",
        "required": ["receiptId", "releaseIssueSnapshotId", "sourceCommitId", "buildRecordId", "envelopeDigest", "validatorVersion", "verificationStatus", "confidence", "edgeRevisions"],
        "properties": {
          "receiptId": { "$ref": "#/components/schemas/OpaqueId" },
          "releaseIssueSnapshotId": { "$ref": "#/components/schemas/OpaqueId" },
          "sourceCommitId": { "$ref": "#/components/schemas/OpaqueId" },
          "buildRecordId": { "$ref": "#/components/schemas/OpaqueId" },
          "envelopeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "validatorVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
          "verificationStatus": { "type": "string", "enum": ["VALID", "INVALID", "CONFLICT", "ERROR"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
          "edgeRevisions": { "type": "array", "minItems": 3, "maxItems": 100, "items": { "$ref": "#/components/schemas/EdgeRevisionResult" } }
        },
        "additionalProperties": false
      },
      "EdgeRevisionResult": {
        "type": "object",
        "required": ["edgeId", "edgeType", "revisionId", "revision", "verificationStatus", "confidence", "factDigest"],
        "properties": {
          "edgeId": { "$ref": "#/components/schemas/OpaqueId" },
          "edgeType": { "type": "string", "enum": ["ISSUE_COMMIT", "COMMIT_BUILD", "BUILD_ARTIFACT"] },
          "revisionId": { "$ref": "#/components/schemas/OpaqueId" },
          "revision": { "type": "integer", "minimum": 1 },
          "verificationStatus": { "type": "string", "enum": ["VALID", "INVALID", "CONFLICT", "ERROR"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
          "factDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      },
      "CreateTestRunRequest": {
        "type": "object",
        "required": ["releaseId", "testPlan", "deviceSelector"],
        "properties": {
          "releaseId": { "$ref": "#/components/schemas/OpaqueId" },
          "testPlan": {
            "type": "object",
            "required": ["planId", "version"],
            "properties": { "planId": { "$ref": "#/components/schemas/OpaqueId" }, "version": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          },
          "deviceSelector": {
            "type": "object",
            "required": ["vehicle", "requiredCapabilities"],
            "properties": { "vehicle": { "type": "string", "minLength": 1 }, "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "RuleSetRequest": {
        "type": "object",
        "required": ["ruleSetId", "version", "rules"],
        "properties": {
          "ruleSetId": { "$ref": "#/components/schemas/OpaqueId" },
          "version": { "type": "integer", "minimum": 1 },
          "rules": { "type": "array", "minItems": 1, "items": { "$ref": "../../../schemas/v0.2/quality-rule.schema.json" } }
        },
        "additionalProperties": false
      },
      "QualityEvaluationRequest": {
        "type": "object",
        "required": ["ruleSet", "testRunIds", "traceabilitySnapshotId"],
        "properties": {
          "ruleSet": {
            "type": "object",
            "required": ["ruleSetId", "version"],
            "properties": { "ruleSetId": { "$ref": "#/components/schemas/OpaqueId" }, "version": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          },
          "testRunIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/components/schemas/OpaqueId" } },
          "traceabilitySnapshotId": { "$ref": "#/components/schemas/OpaqueId" }
        },
        "additionalProperties": false
      },
      "GovernanceDecisionRequest": {
        "type": "object",
        "required": ["decision", "reason", "approvalRef"],
        "properties": {
          "decision": { "enum": ["APPROVE", "REJECT"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "approvalRef": { "$ref": "#/components/schemas/OpaqueId" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "DownloadGrant": {
        "type": "object",
        "required": ["url", "expiresAt"],
        "properties": { "url": { "type": "string", "format": "uri" }, "expiresAt": { "type": "string", "format": "date-time" } },
        "additionalProperties": false
      }
    },
    "requestBodies": {
      "CreateRelease": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReleaseRequest" } } } },
      "RegisterManifest": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/release-manifest.schema.json" } } } },
      "Reason": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reason" } } } },
      "IdentifierInput": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdentifierInput" } } } },
      "ActivateIssueMappingProfile": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivateIssueMappingProfileRequest" } } } },
      "BuildProvenanceEnvelope": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BuildProvenanceEnvelope" } } } },
      "CreateTestRun": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTestRunRequest" } } } },
      "RuleSet": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuleSetRequest" } } } },
      "QualityEvaluation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QualityEvaluationRequest" } } } },
      "GovernanceDecision": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GovernanceDecisionRequest" } } } },
      "AgentRegistration": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/registrationRequest" } } } },
      "AgentHeartbeat": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/heartbeatRequest" } } } },
      "AgentPoll": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/pollRequest" } } } },
      "AgentAck": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/ackRequest" } } } },
      "AgentEvent": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/eventRequest" } } } },
      "AgentCreateUpload": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/createUploadRequest" } } } },
      "AgentCompleteUpload": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/completeUploadRequest" } } } },
      "AgentResult": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/resultRequest" } } } }
    },
    "responses": {
      "Resource": { "description": "Resource response", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericResource" } } } },
      "ManifestExport": { "description": "Immutable authoritative Manifest export", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManifestExport" } } } },
      "ResourceCreated": { "description": "Resource created", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericResource" } } } },
      "IssueMappingProfileActivated": { "description": "Issue mapping profile activated", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IssueMappingProfileActivation" } } } },
      "BuildProvenanceResult": { "description": "Build provenance ingestion result", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BuildProvenanceResult" } } } },
      "Accepted": { "description": "Asynchronous work accepted", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericResource" } } } },
      "ResourceList": { "description": "Cursor-page response", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericList" } } } },
      "Problem": { "description": "RFC 9457 Problem Details", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "DownloadGrant": { "description": "Audited GENERAL/RESTRICTED grant valid for no more than 60 seconds", "headers": { "Cache-Control": { "schema": { "const": "no-store" } }, "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DownloadGrant" } } } },
      "AgentCommand": { "description": "Zero or one command for the negotiated protocol", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "../../../schemas/v0.2/agent-protocol.schema.json#/$defs/commandEnvelope" }, { "type": "null" }] } } } }
    },
    "headers": {
      "RequestId": { "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } }
    }
  }
}
