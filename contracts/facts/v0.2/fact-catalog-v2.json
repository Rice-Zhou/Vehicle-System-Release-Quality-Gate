{
  "schemaVersion": "1.0",
  "catalogId": "mvp-release-facts",
  "version": 2,
  "canonicalizationVersion": "VSRQG-QUALITY-TYPED-1",
  "facts": [
    {
      "path": "release.releaseId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Opaque identity of the Release being evaluated."
    },
    {
      "path": "release.manifest.digest",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Digest of the locked authoritative Manifest."
    },
    {
      "path": "release.manifest.artifacts[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": true,
      "nullable": false,
      "stableOrder": [
        "manifestArrayIndex"
      ],
      "description": "Artifacts in the semantic order stored by the locked Manifest."
    },
    {
      "path": "issues[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": true,
      "nullable": false,
      "stableOrder": [
        "source",
        "sourceIssueId"
      ],
      "description": "Immutable normalized Issue facts captured for the Release."
    },
    {
      "path": "issues[].fixed",
      "type": "BOOLEAN",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Whether the Issue has a validated source change."
    },
    {
      "path": "issues[].included",
      "type": "BOOLEAN",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Whether the validated fix is included in the Release."
    },
    {
      "path": "issues[].verified",
      "type": "BOOLEAN",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Whether the Issue verification criteria passed on the Release."
    },
    {
      "path": "issues[].required",
      "type": "BOOLEAN",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Membership in the published Rule Set requiredIssueRefs; never inferred from severity."
    },
    {
      "path": "issues[].severity",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Normalized Issue severity."
    },
    {
      "path": "traceability.gaps[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": true,
      "nullable": false,
      "stableOrder": [
        "gapDigest"
      ],
      "description": "Materialized missing or invalid traceability links."
    },
    {
      "path": "testResults[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": true,
      "nullable": false,
      "stableOrder": [
        "caseId",
        "caseVersion",
        "attemptNo"
      ],
      "description": "Terminal Test Results selected into the Quality Input Snapshot."
    },
    {
      "path": "testResults[].status",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Terminal status of a Test Result.",
      "enumValues": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "SKIPPED",
        "ERROR",
        "TIMEOUT"
      ]
    },
    {
      "path": "evidence.crashes[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": false,
      "nullable": false,
      "stableOrder": [
        "capturedAt",
        "evidenceId"
      ],
      "description": "Available crash Evidence facts."
    },
    {
      "path": "evidence.anrs[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": false,
      "nullable": false,
      "stableOrder": [
        "capturedAt",
        "evidenceId"
      ],
      "description": "Available ANR Evidence facts."
    },
    {
      "path": "evidence.memory.samples[]",
      "type": "OBJECT",
      "cardinality": "MANY",
      "required": false,
      "nullable": false,
      "stableOrder": [
        "capturedAt",
        "evidenceId"
      ],
      "description": "Memory samples ordered deterministically for consecutive evaluation."
    },
    {
      "path": "traceability.minimumConfidenceLevel",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Lowest stored Traceability confidence; UNKNOWN is not a numeric score.",
      "enumValues": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    {
      "path": "release.project",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Project owning the Release."
    },
    {
      "path": "release.manifest.artifacts[].manifestArrayIndex",
      "type": "INTEGER",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Original Manifest array position."
    },
    {
      "path": "issues[].source",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Authoritative Issue Snapshot sourceId."
    },
    {
      "path": "issues[].sourceIssueId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "External Issue identity in the exact Snapshot."
    },
    {
      "path": "testResults[].caseId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Published Case identity."
    },
    {
      "path": "testResults[].caseVersion",
      "type": "INTEGER",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Published Case version."
    },
    {
      "path": "testResults[].attemptNo",
      "type": "INTEGER",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Selected Attempt sequence number."
    },
    {
      "path": "testResults[].attemptId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Selected formal Attempt identity."
    },
    {
      "path": "testResults[].runId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Formal Test Run identity."
    },
    {
      "path": "testResults[].resultDigest",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Original Result digest; Result has no independent result ID."
    },
    {
      "path": "traceability.gaps[].gapDigest",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Stored Traceability gap gapDigest."
    },
    {
      "path": "traceability.gaps[].diagnosticCode",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Stored Traceability gap diagnosticCode."
    },
    {
      "path": "traceability.gaps[].issueId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Stored Traceability gap issueId."
    },
    {
      "path": "traceability.gaps[].breakEntityType",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Stored Traceability gap breakEntityType."
    },
    {
      "path": "traceability.gaps[].breakEntityId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Stored Traceability gap breakEntityId."
    },
    {
      "path": "traceability.gaps[].expectedEdgeType",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Stored Traceability gap expectedEdgeType."
    },
    {
      "path": "evidence.crashes[].capturedAt",
      "type": "TIMESTAMP",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Evidence item capturedAt."
    },
    {
      "path": "evidence.crashes[].evidenceId",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
      "nullable": false,
      "description": "Evidence item evidenceId."
    },
    {
      "path": "evidence.crashes[].applicationCriticality",
      "type": "STRING",
      "cardinality": "ONE",
      "required": true,
