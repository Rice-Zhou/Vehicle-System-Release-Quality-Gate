{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsrqg.example/contracts/v0.2/fact-catalog-v2.schema.json",
  "title": "VSRQG Fact Catalog v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogId",
    "version",
    "canonicalizationVersion",
    "facts",
    "itemBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "const": 2
    },
    "canonicalizationVersion": {
      "const": "VSRQG-QUALITY-TYPED-1"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "itemBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/itemBinding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "path",
        "type",
        "cardinality",
        "required",
        "nullable",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(release|issues|traceability|testResults|evidence)(\\.[A-Za-z][A-Za-z0-9]*|\\[\\])*$"
        },
        "type": {
          "enum": [
            "BOOLEAN",
            "INTEGER",
            "DECIMAL",
            "STRING",
            "TIMESTAMP",
            "OBJECT"
          ]
        },
        "cardinality": {
          "enum": [
            "ONE",
            "MANY"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "canonicalUnit": {
          "type": "string",
          "minLength": 1
        },
        "stableOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "enumValues": {
          "$ref": "#/$defs/enumValues"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "enumValues"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "STRING"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cardinality": {
                "const": "MANY"
              }
            }
          },
          "then": {
            "required": [
              "stableOrder"
            ],
            "properties": {
              "type": {
                "const": "OBJECT"
              }
            }
          }
        }
      ]
    },
    "enumValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "itemBinding": {
      "type": "object",
      "required": [
        "collectionPath",
        "localPath",
        "factPath"
      ],
      "properties": {
        "collectionPath": {
          "type": "string",
          "pattern": "\\[\\]$"
        },
        "localPath": {
          "type": "string",
          "pattern": "^item\\.[A-Za-z][A-Za-z0-9]*$"
        },
        "factPath": {
          "$ref": "#/$defs/fact/properties/path"
        }
      },
      "additionalProperties": false
    }
  }
}
