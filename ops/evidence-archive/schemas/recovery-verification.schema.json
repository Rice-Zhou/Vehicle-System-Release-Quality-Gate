{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsrqg.example/ops/evidence-archive/recovery-verification.schema.json",
  "title": "VSRQG Evidence Archive Recovery Verification Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "workPackageId",
    "executionId",
    "descriptorSha256",
    "pilotManifestSha256",
    "startedAt",
    "completedAt",
    "archiveIdentity",
    "verifierIdentity",
    "artifacts",
    "status",
    "errorCode",
    "cleanupStatus",
    "cleanupErrorCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workPackageId": { "const": "V0-2-EVIDENCE-ARCHIVE-001" },
    "executionId": {
      "oneOf": [
        { "$ref": "#/$defs/executionId" },
        { "type": "null" }
      ]
    },
    "descriptorSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "pilotManifestSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "startedAt": { "$ref": "#/$defs/instant" },
    "completedAt": { "$ref": "#/$defs/instant" },
    "archiveIdentity": { "$ref": "#/$defs/nullableIdentity" },
    "verifierIdentity": { "$ref": "#/$defs/nullableIdentity" },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "status": { "enum": ["PASS", "FAIL"] },
    "errorCode": {
      "oneOf": [
        { "$ref": "#/$defs/errorCode" },
        { "type": "null" }
      ]
    },
    "cleanupStatus": { "enum": ["PASS", "FAIL"] },
    "cleanupErrorCode": {
      "oneOf": [
        { "const": "RECOVERY_CLEANUP_FAILED" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "executionId": { "$ref": "#/$defs/executionId" },
          "descriptorSha256": { "$ref": "#/$defs/sha256" },
          "pilotManifestSha256": { "$ref": "#/$defs/sha256" },
          "archiveIdentity": { "$ref": "#/$defs/runtimeIdentity" },
          "verifierIdentity": { "$ref": "#/$defs/runtimeIdentity" },
          "artifacts": { "type": "array", "minItems": 2, "maxItems": 2 },
          "errorCode": { "type": "null" },
          "cleanupStatus": { "const": "PASS" },
          "cleanupErrorCode": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "errorCode": { "$ref": "#/$defs/errorCode" }
        }
      }
    },
    {
      "if": {
        "properties": { "cleanupStatus": { "const": "PASS" } },
        "required": ["cleanupStatus"]
      },
      "then": {
        "properties": { "cleanupErrorCode": { "type": "null" } }
      },
      "else": {
        "properties": {
          "status": { "const": "FAIL" },
          "cleanupErrorCode": { "const": "RECOVERY_CLEANUP_FAILED" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "decimalId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3}(?:[0-9]{3})?)?)?Z$"
    },
    "runtimeIdentity": {
      "type": "object",
      "required": ["provider", "principalFingerprint"],
      "properties": {
        "provider": { "const": "S3_COMPATIBLE" },
        "principalFingerprint": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "nullIdentity": {
      "type": "object",
      "required": ["provider", "principalFingerprint"],
      "properties": {
        "provider": { "type": "null" },
        "principalFingerprint": { "type": "null" }
      },
      "additionalProperties": false
    },
    "nullableIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/runtimeIdentity" },
        { "$ref": "#/$defs/nullIdentity" }
      ]
    },
    "bucket": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "versionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?! +$)(?!(?:[Nn][Uu][Ll][Ll])$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 8
    },
    "exactReference": {
      "type": "object",
      "required": ["provider", "locator", "bucket", "key", "versionId", "sha256", "sizeBytes"],
      "properties": {
        "provider": { "const": "S3_COMPATIBLE" },
        "locator": { "$ref": "#/$defs/locator" },
        "bucket": { "$ref": "#/$defs/bucket" },
        "key": { "$ref": "#/$defs/key" },
        "versionId": { "$ref": "#/$defs/versionId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "protection": {
      "type": "object",
      "required": ["actualMode", "retainUntil"],
      "properties": {
        "actualMode": { "const": "COMPLIANCE" },
        "retainUntil": { "$ref": "#/$defs/instant" }
      },
      "additionalProperties": false
    },
    "recoveredObject": {
      "type": "object",
      "required": ["reference", "recoveredSha256", "recoveredSizeBytes", "protection"],
      "properties": {
        "reference": { "$ref": "#/$defs/exactReference" },
        "recoveredSha256": { "$ref": "#/$defs/sha256" },
        "recoveredSizeBytes": { "type": "integer", "minimum": 1 },
        "protection": { "$ref": "#/$defs/protection" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifactId", "sourceRunId", "sourceCommit", "receiptArchivedAt", "payload", "receipt"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/decimalId" },
        "sourceRunId": { "$ref": "#/$defs/decimalId" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "receiptArchivedAt": { "$ref": "#/$defs/instant" },
        "payload": { "$ref": "#/$defs/recoveredObject" },
        "receipt": { "$ref": "#/$defs/recoveredObject" }
      },
      "additionalProperties": false
    },
    "errorCode": {
      "enum": [
        "SAME_RUNTIME_IDENTITY",
        "LATEST_REFERENCE_FORBIDDEN",
        "VERSION_MISMATCH",
        "DIGEST_MISMATCH",
        "SIZE_MISMATCH",
        "RECEIPT_MISMATCH",
        "PROTECTION_INSUFFICIENT",
        "RECOVERY_ROOT_INVALID",
        "RECOVERY_CLEANUP_FAILED",
        "DOWNLOAD_FAILED",
        "UNEXPECTED_FAILURE"
      ]
    }
  }
}
