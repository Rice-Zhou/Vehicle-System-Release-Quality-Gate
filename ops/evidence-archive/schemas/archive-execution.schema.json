{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsrqg.example/ops/evidence-archive/archive-execution.schema.json",
  "title": "VSRQG Evidence Archive Execution Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "workPackageId",
    "executionId",
    "descriptorSha256",
    "pilotManifestSha256",
    "startedAt",
    "completedAt",
    "policyFingerprint",
    "capabilityCheckedAt",
    "runtimeIdentity",
    "artifacts",
    "accessOwner",
    "retentionPolicy",
    "immutabilityControl",
    "status",
    "errorCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workPackageId": { "const": "V0-2-EVIDENCE-ARCHIVE-001" },
    "executionId": { "$ref": "#/$defs/executionId" },
    "descriptorSha256": { "$ref": "#/$defs/sha256" },
    "pilotManifestSha256": { "$ref": "#/$defs/sha256" },
    "startedAt": { "$ref": "#/$defs/instant" },
    "completedAt": { "$ref": "#/$defs/instant" },
    "policyFingerprint": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "capabilityCheckedAt": {
      "oneOf": [
        { "$ref": "#/$defs/instant" },
        { "type": "null" }
      ]
    },
    "runtimeIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/runtimeIdentity" },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "accessOwner": {
      "oneOf": [
        { "$ref": "#/$defs/accessOwner" },
        { "type": "null" }
      ]
    },
    "retentionPolicy": {
      "oneOf": [
        { "$ref": "#/$defs/retentionPolicy" },
        { "type": "null" }
      ]
    },
    "immutabilityControl": {
      "oneOf": [
        { "const": "COMPLIANCE" },
        { "type": "null" }
      ]
    },
    "status": { "enum": ["PASS", "FAIL"] },
    "errorCode": {
      "oneOf": [
        { "$ref": "#/$defs/errorCode" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "policyFingerprint": { "$ref": "#/$defs/sha256" },
          "capabilityCheckedAt": { "$ref": "#/$defs/instant" },
          "runtimeIdentity": { "$ref": "#/$defs/runtimeIdentity" },
          "artifacts": { "type": "array", "minItems": 2, "maxItems": 2 },
          "accessOwner": { "$ref": "#/$defs/accessOwner" },
          "retentionPolicy": { "$ref": "#/$defs/retentionPolicy" },
          "immutabilityControl": { "const": "COMPLIANCE" },
          "errorCode": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "errorCode": { "$ref": "#/$defs/errorCode" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifacts": { "type": "array", "minItems": 1 } },
        "required": ["artifacts"]
      },
      "then": {
        "properties": {
          "policyFingerprint": { "$ref": "#/$defs/sha256" },
          "capabilityCheckedAt": { "$ref": "#/$defs/instant" },
          "runtimeIdentity": { "$ref": "#/$defs/runtimeIdentity" },
          "accessOwner": { "$ref": "#/$defs/accessOwner" },
          "retentionPolicy": { "$ref": "#/$defs/retentionPolicy" },
          "immutabilityControl": { "const": "COMPLIANCE" }
        }
      },
      "else": {
        "properties": {
          "policyFingerprint": { "type": "null" },
          "capabilityCheckedAt": { "type": "null" },
          "runtimeIdentity": { "type": "null" },
          "accessOwner": { "type": "null" },
          "retentionPolicy": { "type": "null" },
          "immutabilityControl": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "decimalId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3}(?:[0-9]{3}(?:[0-9]{3})?)?)?Z$"
    },
    "accessOwner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$"
    },
    "retentionPolicy": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^P(?!0(?:D|Y|M|W|T))(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+(?:\\.[0-9]+)?S)?)?$"
    },
    "runtimeIdentity": {
      "type": "object",
      "required": ["provider", "principalFingerprint"],
      "properties": {
        "provider": { "const": "S3_COMPATIBLE" },
        "principalFingerprint": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "bucket": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:[\\u0009-\\u000d\\u001c-\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])+$)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "versionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?! +$)(?!(?:[Nn][Uu][Ll][Ll])$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 8
    },
    "exactReference": {
      "type": "object",
      "required": ["provider", "locator", "bucket", "key", "versionId", "sha256", "sizeBytes"],
      "properties": {
        "provider": { "const": "S3_COMPATIBLE" },
        "locator": { "$ref": "#/$defs/locator" },
        "bucket": { "$ref": "#/$defs/bucket" },
        "key": { "$ref": "#/$defs/key" },
        "versionId": { "$ref": "#/$defs/versionId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifactId", "sourceRunId", "sourceCommit", "payload", "receiptReference"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/decimalId" },
        "sourceRunId": { "$ref": "#/$defs/decimalId" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "payload": { "$ref": "#/$defs/exactReference" },
        "receiptReference": { "$ref": "#/$defs/exactReference" }
      },
      "additionalProperties": false
    },
    "errorCode": {
      "enum": [
        "WORK_PACKAGE_INVALID",
        "WORK_PACKAGE_READ_FAILED",
        "ARCHIVE_INPUT_FAILURE",
        "ARCHIVE_INTEGRITY_FAILURE",
        "ARCHIVE_UNAVAILABLE",
        "ARCHIVE_VERIFICATION_FAILURE",
        "ARCHIVE_POLICY_FAILURE",
        "ARCHIVE_RESULT_INVALID",
        "ARCHIVE_RESULT_CONFLICT",
        "REPORT_OUTPUT_INVALID",
        "REPORT_TARGET_EXISTS",
        "REPORT_WRITE_FAILED",
        "REPORT_SERIALIZATION_FAILED",
        "REPORT_CLEANUP_FAILED",
        "CONFIGURATION_INVALID",
        "VERIFICATION_UNAVAILABLE",
        "USAGE_ERROR",
        "UNEXPECTED_FAILURE"
      ]
    }
  }
}
